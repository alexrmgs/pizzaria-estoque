// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RevenueChannel {
  LOJA_PROPRIA
  IFOOD
  NOVENTA_NOVE
}

enum RecipeType {
  PRODUCAO
  PIZZA
  BEIRUTE
  ESFIHA
}

enum MovementType {
  ENTRADA
  SAIDA
}

enum Unit {
  KG
  G
  L
  ML
  UN
  PECA
  FARDO
  PCT
  CX
}

model Role {
  id                    String   @id @default(cuid())
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id])
  name                  String
  canManageEstoque      Boolean  @default(false)
  canManageReceitas     Boolean  @default(false)
  canManageUsuarios     Boolean  @default(false)
  canViewRelatorios     Boolean  @default(false)
  canManageFuncionarios Boolean  @default(false)
  canPrintEtiquetas     Boolean  @default(false)
  canPrintProducao      Boolean  @default(false)
  createdAt             DateTime @default(now())

  users User[]

  @@unique([companyId, name])
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  email        String   @unique
  passwordHash String
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  whatsappPhone String? @unique
  createdAt    DateTime @default(now())

  movements StockMovement[]
  revenues  Revenue[]
  advances  Advance[]
  payments  Payment[]
  employee  Employee?
  approvedSwaps ShiftSwapRequest[]
  whatsappPendingMovements WhatsappPendingMovement[]
  fixedCosts        FixedCost[]
  variableCostRates VariableCostRate[]

  @@index([roleId])
  @@index([companyId])
}

// Empresa (tenant) — o nível acima de Loja. Cada empresa é um cliente
// isolado do sistema (dados e login separados); uma empresa pode ter 1+
// lojas. Hoje só User/Role/Store/AppSettings são por empresa — o resto
// (estoque, receitas, notas, caixa etc) ainda é global, migração gradual.
model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  stores   Store[]
  users    User[]
  roles    Role[]
  settings AppSettings?
}

/**
 * Rascunho de uma movimentação de estoque que a IA interpretou de uma
 * mensagem do WhatsApp, mas que ainda não foi confirmada pelo funcionário —
 * evita gravar no estoque uma interpretação errada sem ninguém perceber.
 */
model WhatsappPendingMovement {
  id           String       @id @default(cuid())
  phone        String
  ingredientId String
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id])
  quantity     Decimal      @db.Decimal(10, 3)
  type         MovementType
  rawMessage   String
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  createdAt    DateTime     @default(now())

  @@index([phone])
}

enum OvertimeMode {
  HORA_EXTRA
  BANCO_HORAS
}

enum PontoMode {
  CELULAR
  FACIAL
}

enum PrintJobStatus {
  PENDENTE
  IMPRESSO
}

enum PrintJobType {
  PEDIDO
  PRODUCAO
}

// Fila de impressão de etiquetas. O tablet enfileira aqui; o programa no PC
// da loja pega os PENDENTE, imprime na impressora e marca como IMPRESSO.
// Dois tipos: PEDIDO (pedido + volumes numerados) e PRODUCAO (produto + data
// de produção + validade).
model PrintJob {
  id            String         @id @default(cuid())
  tipo          PrintJobType   @default(PEDIDO)
  pedido        String?
  cliente       String?
  volumes       Int?
  volumeUnico   Int?
  produto       String?
  producaoData  DateTime?      @db.Date
  validadeData  DateTime?      @db.Date
  temperatura   String?
  responsavel   String?
  peso          String?
  copias        Int?
  labelWidthMm  Int
  labelHeightMm Int
  status        PrintJobStatus @default(PENDENTE)
  createdAt     DateTime       @default(now())
  printedAt     DateTime?

  @@index([status, createdAt])
}

model AppSettings {
  id                  String       @id @default(cuid())
  companyId           String       @unique
  company             Company      @relation(fields: [companyId], references: [id])
  pontoMode           PontoMode    @default(CELULAR)
  overtimeMode        OvertimeMode @default(HORA_EXTRA)
  dailyExpectedHours  Decimal      @default(8) @db.Decimal(4, 2)
  overtimeRate        Decimal      @default(1.5) @db.Decimal(4, 2)
  inssBrackets        Json         @default("[{\"upTo\":1412.00,\"rate\":0.075},{\"upTo\":2666.68,\"rate\":0.09},{\"upTo\":4000.03,\"rate\":0.12},{\"upTo\":7786.02,\"rate\":0.14}]")
  irrfBrackets        Json         @default("[{\"upTo\":2259.20,\"rate\":0},{\"upTo\":2826.65,\"rate\":0.075},{\"upTo\":3751.05,\"rate\":0.15},{\"upTo\":4664.68,\"rate\":0.225},{\"upTo\":null,\"rate\":0.275}]")
  irrfDependentDeduction Decimal   @default(189.59) @db.Decimal(10, 2)
  valeTransporteRate  Decimal      @default(6) @db.Decimal(4, 2)
  latePenaltyPoints   Int          @default(3)
  labelWidthMm        Int          @default(100)
  labelHeightMm       Int          @default(70)
  labelProducaoWidthMm  Int        @default(100)
  labelProducaoHeightMm Int        @default(70)
  etiquetaProximoNumero Int        @default(1)
  etiquetaImpressos   Json         @default("[]")
  focusUltimaVersao   Int          @default(0)
  labelEmpresa        String?
  labelCnpj           String?
  labelEndereco       String?
  labelCep            String?
  labelCidade         String?
  attendanceBonusTiers Json        @default("[{\"minScore\":100,\"bonus\":0}]")
  attendanceStreakTiers Json       @default("[{\"months\":6,\"multiplier\":3},{\"months\":3,\"multiplier\":2},{\"months\":0,\"multiplier\":1}]")
  updatedAt           DateTime     @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  ingredients Ingredient[]
}

model Ingredient {
  id           String   @id @default(cuid())
  name         String   @unique
  unit         Unit
  unitPrice    Decimal  @default(0) @db.Decimal(10, 2)
  currentStock Decimal  @default(0) @db.Decimal(10, 3)
  minStock     Decimal  @default(0) @db.Decimal(10, 3)
  idealStock   Decimal? @db.Decimal(10, 3)
  includeInCmv Boolean  @default(true)
  isProduced   Boolean  @default(false)
  recipeUnit      Unit?
  unitsPerPackage Decimal @default(1) @db.Decimal(10, 3)
  correctionGrossWeight Decimal? @db.Decimal(10, 3)
  correctionNetWeight   Decimal? @db.Decimal(10, 3)
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  movements        StockMovement[]
  recipeIngredients RecipeIngredient[]
  whatsappPendingMovements WhatsappPendingMovement[]

  @@index([categoryId])
}

model StockMovement {
  id           String       @id @default(cuid())
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id])
  ingredientId String
  type         MovementType
  quantity     Decimal      @db.Decimal(10, 3)
  reason       String?
  user         User         @relation(fields: [userId], references: [id])
  userId       String
  createdAt    DateTime     @default(now())
  unitPriceAtEntry Decimal? @db.Decimal(10, 2)

  @@index([ingredientId])
  @@index([userId])
  @@index([createdAt])
}

model Revenue {
  id         String         @id @default(cuid())
  date       DateTime       @db.Date
  storeId    String
  store      Store          @relation(fields: [storeId], references: [id])
  channel    RevenueChannel @default(LOJA_PROPRIA)
  amount     Decimal        @db.Decimal(10, 2)
  orderCount Int            @default(0)
  note       String?
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([date, storeId, channel])
  @@index([storeId])
}

model FixedCost {
  id             String   @id @default(cuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id])
  category       String
  referenceMonth DateTime @db.Date
  amount         Decimal  @db.Decimal(10, 2)
  note           String?
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([storeId, category, referenceMonth])
  @@index([storeId])
}

model VariableCostRate {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  category   String
  percentage Decimal  @db.Decimal(6, 3)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([storeId, category])
  @@index([storeId])
}

model Recipe {
  id           String     @id @default(cuid())
  name         String
  type         RecipeType @default(PRODUCAO)
  description  String?
  instructions String?
  imageUrl     String?
  yieldKg      Decimal?   @db.Decimal(10, 3)
  yieldUnits   Int?
  currentPrice Decimal?   @db.Decimal(10, 2)
  order        Int        @default(0)
  createdAt    DateTime   @default(now())

  ingredients RecipeIngredient[]

  @@index([type])
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId     String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId String
  quantity     Decimal    @db.Decimal(10, 3)
  wastePercent Decimal    @default(0) @db.Decimal(5, 2)
  order        Int        @default(0)

  @@index([recipeId])
  @@index([ingredientId])
}

model Store {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  address      String?
  latitude     Decimal  @db.Decimal(10, 7)
  longitude    Decimal  @db.Decimal(10, 7)
  radiusMeters Int      @default(150)
  saiposToken  String?
  // Método usado na Precificação: "MARKUP" (custo / (1 - %fixo - %variável))
  // ou "MARGEM" (custo / (1 - %variável - margem de contribuição desejada)).
  pricingMethod       String   @default("MARKUP")
  targetMarginPercent Decimal? @db.Decimal(5, 2)
  // Open Finance (Pluggy) próprio dessa loja — o responsável de lá faz o
  // cadastro Meu Pluggy dele e conecta o banco dele com essas credenciais.
  // Se vazio, cai pras variáveis de ambiente globais (compatibilidade).
  pluggyClientId     String?
  pluggyClientSecret String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employees         Employee[]
  revenues          Revenue[]
  fixedCosts        FixedCost[]
  variableCostRates VariableCostRate[]

  @@index([companyId])
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now())

  @@unique([date])
}

enum PayableStatus {
  PENDENTE
  PAGA
}

enum NotaStatus {
  CONFERINDO
  LANCADA
}

// Nota fiscal de entrada (compra de fornecedor). Pode vir de XML da NFe ou ser
// digitada. Fica em CONFERINDO até o usuário conferir/casar os itens e lançar
// a entrada no estoque (vira LANCADA). Se for boleto, gera uma conta a pagar.
model NotaFiscal {
  id          String           @id @default(cuid())
  numero      String?
  fornecedor  String?
  chave       String?
  emissao     DateTime?        @db.Date
  total       Decimal          @default(0) @db.Decimal(10, 2)
  status      NotaStatus       @default(CONFERINDO)
  boleto      Boolean          @default(false)
  vencimento  DateTime?        @db.Date
  payableId   String?
  userId      String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       NotaFiscalItem[]
}

model NotaFiscalItem {
  id           String     @id @default(cuid())
  nota         NotaFiscal @relation(fields: [notaId], references: [id], onDelete: Cascade)
  notaId       String
  description  String
  unit         String?
  quantity     Decimal    @db.Decimal(10, 3)
  unitValue    Decimal    @db.Decimal(10, 4)
  total        Decimal    @db.Decimal(10, 2)
  ingredientId String?
  fator        Decimal    @default(1) @db.Decimal(12, 4)
  createdAt    DateTime   @default(now())

  @@index([notaId])
}

// Conta a pagar / despesa do financeiro (aluguel, fornecedor, imposto...).
// Quando paga, guarda a data do pagamento pra entrar no fluxo de caixa.
model Payable {
  id          String        @id @default(cuid())
  companyId   String
  description String
  category    String
  amount      Decimal       @db.Decimal(10, 2)
  dueDate     DateTime      @db.Date
  status      PayableStatus @default(PENDENTE)
  paidDate    DateTime?     @db.Date
  storeId     String?
  note        String?
  userId      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, dueDate])
  @@index([companyId])
}

// Conexão bancária via Pluggy (Open Finance). Guarda só o itemId retornado
// pelo widget; os dados (saldo/extrato) são consultados na hora pela API.
model BankConnection {
  id        String   @id @default(cuid())
  itemId    String   @unique
  name      String?
  storeId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id         String    @id @default(cuid())
  name       String
  role       String?
  phone      String?
  baseSalary Decimal   @default(0) @db.Decimal(10, 2)
  dependents Int       @default(0)
  hireDate   DateTime? @db.Date
  scheduledStart String?
  scheduledEnd   String?
  weeklyDayOff   Int?
  active     Boolean   @default(true)
  faceDescriptor Json?
  userId     String?   @unique
  user       User?     @relation(fields: [userId], references: [id])
  storeId    String?
  store      Store?    @relation(fields: [storeId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  timeEntries TimeEntry[]
  advances    Advance[]
  adjustments PayrollAdjustment[]
  payments    Payment[]
  dayOffs     DayOff[]
  swapRequestsSent     ShiftSwapRequest[] @relation("SwapRequester")
  swapRequestsReceived ShiftSwapRequest[] @relation("SwapTarget")

  @@index([storeId])
}

model TimeEntry {
  id         String    @id @default(cuid())
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  date       DateTime  @db.Date
  clockIn    DateTime
  clockInDistanceM  Int?
  clockInPhoto  String?
  clockOut   DateTime?
  clockOutDistanceM Int?
  clockOutPhoto String?
  note       String?
  createdAt  DateTime  @default(now())

  @@index([employeeId])
  @@index([date])
}

enum AbsenceType {
  FOLGA
  ATESTADO
  FALTA
  TRABALHA
}

model DayOff {
  id         String      @id @default(cuid())
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  date       DateTime    @db.Date
  type       AbsenceType @default(FOLGA)
  reason     String?
  createdAt  DateTime    @default(now())

  @@unique([employeeId, date])
  @@index([employeeId])
}

enum SwapStatus {
  PENDENTE
  ACEITO_PELO_FUNCIONARIO
  RECUSADO_PELO_FUNCIONARIO
  APROVADO
  RECUSADO_PELA_GERENCIA
  CANCELADO
}

/**
 * Troca de folga entre dois funcionários: o solicitante propõe dar sua
 * folga de `requesterDate` e assumir a folga de `targetDate` do colega. Só
 * vira realidade (ajusta os registros de folga dos dois) quando o colega
 * aceita E um gerente aprova.
 */
model ShiftSwapRequest {
  id            String     @id @default(cuid())
  requester     Employee   @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId   String
  target        Employee   @relation("SwapTarget", fields: [targetId], references: [id], onDelete: Cascade)
  targetId      String
  requesterDate DateTime   @db.Date
  targetDate    DateTime   @db.Date
  status        SwapStatus @default(PENDENTE)
  note          String?
  targetRespondedAt  DateTime?
  managerId          String?
  manager            User?     @relation(fields: [managerId], references: [id])
  managerRespondedAt DateTime?
  createdAt     DateTime   @default(now())

  @@index([requesterId])
  @@index([targetId])
  @@index([status])
}

enum AdjustmentType {
  BONUS
  DESCONTO
}

model PayrollAdjustment {
  id          String         @id @default(cuid())
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String
  type        AdjustmentType
  date        DateTime       @db.Date
  amount      Decimal        @db.Decimal(10, 2)
  description String?
  paymentId   String?
  payment     Payment?       @relation(fields: [paymentId], references: [id])
  createdAt   DateTime       @default(now())

  @@index([employeeId])
  @@index([date])
}

model Advance {
  id          String   @id @default(cuid())
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String
  date        DateTime @db.Date
  amount      Decimal  @db.Decimal(10, 2)
  description String?
  paymentId   String?
  payment     Payment? @relation(fields: [paymentId], references: [id])
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  userId      String

  @@index([employeeId])
  @@index([date])
}

model Payment {
  id            String   @id @default(cuid())
  employee      Employee @relation(fields: [employeeId], references: [id])
  employeeId    String
  periodStart   DateTime @db.Date
  periodEnd     DateTime @db.Date
  baseSalary    Decimal  @db.Decimal(10, 2)
  nightPremium  Decimal  @db.Decimal(10, 2)
  overtimeHours Decimal  @default(0) @db.Decimal(6, 2)
  overtimeAmount Decimal @default(0) @db.Decimal(10, 2)
  bankedHours   Decimal  @default(0) @db.Decimal(6, 2)
  lateDiscountMinutes Decimal @default(0) @db.Decimal(6, 2)
  lateDiscountAmount  Decimal @default(0) @db.Decimal(10, 2)
  faltaDays     Decimal  @default(0) @db.Decimal(4, 1)
  faltaAmount   Decimal  @default(0) @db.Decimal(10, 2)
  inssAmount    Decimal  @default(0) @db.Decimal(10, 2)
  irrfAmount    Decimal  @default(0) @db.Decimal(10, 2)
  valeTransporteAmount Decimal @default(0) @db.Decimal(10, 2)
  bonusTotal    Decimal  @db.Decimal(10, 2)
  discountTotal Decimal  @db.Decimal(10, 2)
  advancesTotal Decimal  @db.Decimal(10, 2)
  attendanceScore  Int     @default(100)
  attendanceStreakMonths Int @default(0)
  attendanceBonusAmount Decimal @default(0) @db.Decimal(10, 2)
  netAmount     Decimal  @db.Decimal(10, 2)
  note          String?
  paidAt        DateTime @default(now())
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
  userId        String

  advances    Advance[]
  adjustments PayrollAdjustment[]

  @@index([employeeId])
}

enum CashDirection {
  ENTRADA
  SAIDA
}

enum CashSaidaTipo {
  PAGAMENTO
  FUNDO
}

// Lançamento do caixa de dinheiro em espécie (cédulas). ENTRADA = fechamento do
// dia (venda em dinheiro); SAIDA = pagamento em dinheiro ou retirada pra fundo
// de caixa. Espelha as tabelas ENTRADAS/SAÍDAS da planilha de controle.
model CashEntry {
  id          String         @id @default(cuid())
  companyId   String
  date        DateTime       @db.Date
  description String
  direction   CashDirection
  tipo        CashSaidaTipo?
  amount      Decimal        @db.Decimal(10, 2)
  userId      String?
  createdAt   DateTime       @default(now())

  @@index([companyId, date])
}

// Configuração/fechamento do mês do caixa de dinheiro: saldo inicial, estoque
// inicial de cada moeda e a conferência física da virada de mês.
model CashMonth {
  id              String   @id @default(cuid())
  companyId       String
  month           String   // YYYY-MM
  saldoInicial    Decimal  @default(0) @db.Decimal(10, 2)
  saldoAnterior   Decimal? @db.Decimal(10, 2)
  ini05           Int      @default(0)
  ini10           Int      @default(0)
  ini25           Int      @default(0)
  ini50           Int      @default(0)
  ini100          Int      @default(0)
  cedulasContadas Decimal? @db.Decimal(10, 2)
  moedasContadas  Decimal? @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, month])
}

// Movimentação diária de moedas: quantidade de cada denominação que entrou ou
// saiu do estoque de moedas (usado pra montar o fundo de caixa).
model CoinMovement {
  id        String        @id @default(cuid())
  companyId String
  date      DateTime      @db.Date
  direction CashDirection
  q05       Int           @default(0)
  q10       Int           @default(0)
  q25       Int           @default(0)
  q50       Int           @default(0)
  q100      Int           @default(0)
  note      String?
  createdAt DateTime      @default(now())

  @@index([companyId, date])
}
